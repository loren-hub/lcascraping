# Clave de API de Resend para envío de correos (Requerido para send_emails.py)
# Regístrate y obtén tu clave en: https://resend.com/api-keys
RESEND_API_KEY=re_tu_clave_de_resend_aqui

# Sobrescrituras opcionales en tiempo de ejecución (anulan valores en config.yaml)
# MAX_RESULTS=40
# HEADLESS=true
